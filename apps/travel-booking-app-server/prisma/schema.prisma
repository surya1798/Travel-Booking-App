datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  email       String    @unique
  fname       String
  id          String    @id @default(cuid())
  lname       String
  phoneNumber Int       @unique
  updatedAt   DateTime  @updatedAt
}

model Flight {
  createdAt    DateTime @default(now())
  flightNumber Int?
  id           String   @id @default(cuid())
  name         String
  updatedAt    DateTime @updatedAt
}

model Destination {
  country            Country? @relation(fields: [countryId], references: [id])
  countryId          String?  @unique
  createdAt          DateTime @default(now())
  destinationName    String?
  id                 String   @id @default(cuid())
  isBusesAvailable   Boolean?
  isFlightsAvailable Boolean?
  isTrainsAvailable  Boolean?
  updatedAt          DateTime @updatedAt
}

model Train {
  createdAt   DateTime @default(now())
  id          String   @id @default(cuid())
  trainName   String
  trainNumber String   @unique
  updatedAt   DateTime @updatedAt
}

model Booking {
  bookingDate  DateTime
  createdAt    DateTime @default(now())
  id           String   @id @default(cuid())
  travelingVia String
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
  userId       String
}

model Country {
  countryCode  String?
  countryName  String?
  createdAt    DateTime     @default(now())
  destinations Destination?
  id           String       @id @default(cuid())
  updatedAt    DateTime     @updatedAt
}
